{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bph",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    // Set to your AI Gateway endpoint to route Gemini through it, e.g.
    // https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway>/google-ai-studio
    "GEMINI_BASE_URL": "https://generativelanguage.googleapis.com",
    "AUTHORIZED_PARTIES": "https://bph.partavocado.cc,http://localhost:5173",
    "DAILY_RUN_LIMIT": "20",
    "RUN_TOKEN_BUDGET": "400000"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "bph", "database_id": "814de9a0-8860-4226-87e9-2663ff564d19", "migrations_dir": "migrations" }
  ],
  // Required by `wrangler preview`. Previews share the production database; give them their own
  // database_id here if preview builds shouldn't touch real data.
  "previews": {
    "d1_databases": [{ "binding": "DB", "database_id": "814de9a0-8860-4226-87e9-2663ff564d19" }]
  },
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "offshoot-uploads" }],
  "durable_objects": {
    "bindings": [{ "name": "RUN", "class_name": "RunObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RunObject"] }]
}
